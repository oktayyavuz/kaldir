@dataclass
class Package:
    name: str
    source: str              # "Pacman", "AUR" veya "Flatpak"
    size: int                # bayt
    description: str
    installation: str = ""   # Flatpak için "system" ya da "user"
    protected: str = ""      # boş değilse korumalı; değer = neden
    warning: str = ""        # boş değilse dikkat gerektirir; değer = neden
    app_name: str = ""       # menüde görünen ad (uygulama değilse boş)
    icon: str = ""           # simge adı ya da yolu
    search_text: str = ""    # aramada kullanılan ek adlar
    bundle: str = ""         # uygulama bir demet paketiyle geldiyse demetin adı

    @property
    def is_app(self) -> bool:
        return bool(self.app_name)

    @property
    def title(self) -> str:
        return self.app_name or self.name


def to_bytes(value: str, unit: str) -> int:
    try:
        number = float(value.replace(",", "."))
    except ValueError:
        return 0
    return int(number * UNITS.get(unit.upper(), 1))


def human(size: float) -> str:
    for unit in ("B", "KiB", "MiB", "GiB"):
        if size < 1024:
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} TiB"


def _output(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, env=C_ENV).stdout
    except FileNotFoundError:
        return ""


def parse_pacman_info(text: str) -> list[dict]:
    """`pacman -Qi` çıktısını paket başına sözlüğe çevirir (çok satırlı alanlar dahil)."""
    blocks = []
    for block in text.split("\n\n"):
        info, last = {}, None
        for line in block.splitlines():
            if line.startswith(" ") and last:
                info[last] += " " + line.strip()
            elif " : " in line:
                key, value = line.split(" : ", 1)
                last = key.strip()
                info[last] = value.strip()
        if "Name" in info:
            blocks.append(info)
    return blocks


def pacman_packages(flags: str, source: str) -> list[Package]:
    packages = []
    for info in parse_pacman_info(_output(["pacman", flags])):
        value, unit = (info.get("Installed Size", "0 B").split() + ["B"])[:2]
        packages.append(Package(info["Name"], source, to_bytes(value, unit),
                                info.get("Description", "")))
    return packages


def flatpak_packages() -> list[Package]:
    packages = []
    out = _output(["flatpak", "list", "--app",
                   "--columns=application,name,description,size,installation"])
    # flatpak sayı ile birim arasına bölünemez boşluk (U+00A0) koyar
    for line in out.replace(" ", " ").splitlines():
        parts = line.split("\t")
        if len(parts) < 5:
            continue
        app_id, name, description, size, installation = parts[:5]
        value, unit = (size.split() + ["B"])[:2]
        packages.append(Package(app_id, "Flatpak", to_bytes(value, unit),
                                description or name, installation.strip().lower(),
                                app_name=name or app_id, icon=app_id))
    return packages


