    def is_listed(self, pkg: Package) -> bool:
        """Arama dışındaki süzgeçler (görünüm, kaynak, korumalılar)."""
        source = self.source.currentText()
        return ((self.scope.currentIndex() == self.SCOPE_ALL or pkg.is_app)
                and (source == "Tüm kaynaklar" or pkg.source == source)
                and (self.show_protected.isChecked() or not pkg.protected))

    def apply_filter(self):
        text = self.search.text().strip().lower()
        for row in range(self.table.rowCount()):
            pkg = self.package_at(row)
            haystack = f"{pkg.title} {pkg.name} {pkg.description} {pkg.search_text}".lower()
            self.table.setRowHidden(row, not (self.is_listed(pkg) and (not text or text in haystack)))
        self.update_status()

    def package_at(self, row: int) -> Package:
        return self.packages[self.table.item(row, self.COL_NAME).data(Qt.ItemDataRole.UserRole)]

    # --- Seçim -----------------------------------------------------------

    def checked_packages(self) -> list[Package]:
        result = []
        for row in range(self.table.rowCount()):
            pkg = self.package_at(row)
            if not pkg.protected and self.table.item(row, self.COL_NAME).checkState() == Qt.CheckState.Checked:
                result.append(pkg)
        return result

    def toggle_row(self, row: int, column: int):
        if column == self.COL_NAME or self.package_at(row).protected:
            return
        item = self.table.item(row, self.COL_NAME)
        item.setCheckState(Qt.CheckState.Unchecked if item.checkState() == Qt.CheckState.Checked
                           else Qt.CheckState.Checked)

    def toggle_current(self):
        row = self.table.currentRow()
        if row >= 0:
            self.toggle_row(row, self.COL_SOURCE)

    def clear_selection(self):
        self.table.blockSignals(True)
        for row in range(self.table.rowCount()):
            if not self.package_at(row).protected:
                self.table.item(row, self.COL_NAME).setCheckState(Qt.CheckState.Unchecked)
        self.table.blockSignals(False)
        self.update_status()

    def update_status(self, *_):
        selected = self.checked_packages()
        source = self.source.currentText()
        listed = [p for p in self.packages
                  if (self.scope.currentIndex() == self.SCOPE_ALL or p.is_app)
                  and (source == "Tüm kaynaklar" or p.source == source)]
        removable = [p for p in listed if not p.protected]
        kind = "uygulama" if self.scope.currentIndex() == self.SCOPE_APPS else "paket"
        text = (f"{len(removable)} kaldırılabilir {kind} · {human(sum(p.size for p in removable))}"
                f" · {len(listed) - len(removable)} korumalı")
        if selected:
            text += f"   |   Seçilen: {len(selected)} · {human(sum(p.size for p in selected))}"
        self.status.setText(text)
        self.remove_btn.setEnabled(bool(selected))

    # --- Kaldırma ------------------------------------------------------

    def remove_selected(self):
        selected = self.checked_packages()
        if any(p.protected for p in selected) or self.state is None:
            return
        pacman_names = [p.name for p in selected if p.source in ("Pacman", "AUR")]
        flatpaks = [p for p in selected if p.source == "Flatpak"]
        titles = {p.name: p.title for p in self.packages}

        lines, warnings, notes, total = [], [], [], 0
        plan = None
        if pacman_names:
            plan = plan_pacman_removal(pacman_names, self.state, titles)
            if not plan.ok:
                box = QMessageBox(QMessageBox.Icon.Warning, "Kaldırılamaz",
                                  "Seçtiklerinden en az birini başka bir program kullanıyor, "
                                  "bu yüzden hiçbir şey kaldırılmadı.\n\n"
                                  + ("\n".join(plan.reasons) + "\n\n" if plan.reasons else "")
                                  + "Onu kullanan programı da seçebilir ya da seçimini değiştirebilirsin.",
                                  QMessageBox.StandardButton.Ok, self)
                if plan.error:
                    box.setDetailedText(plan.error)
                box.exec()
                return

            for name, size in plan.remove:
                if name in pacman_names:
                    note = ""
                elif name in plan.bundles:
                    note = "  (demet paketi, yalnızca liste)"
                else:
                    note = "  (artık gereksiz bağımlılık)"
                label = titles.get(name, name) if name in pacman_names else name
                lines.append(f"{label:<40} {human(size):>10}{note}")
                total += size
                if name in self.state.warn and name not in plan.bundles:
                    warnings.append(f"⚠ {name} — {self.state.warn[name]}")
            protected_kept = [n for n in plan.keep if n in self.state.protected]
            bundle_kept = [n for n in plan.keep if n not in self.state.protected]
            warnings += [f"🔒 {n} korunacak — {self.state.protected[n]}" for n in protected_kept]
            if plan.bundles:
                apps_kept = [titles[n] for n in bundle_kept if n in titles]
                notes.append(
                    f"📦 Seçtiğin program {', '.join(plan.bundles)} demetiyle kurulmuş. "
                    "Demet paketi de kaldırılacak; içindeki diğer paketler yerinde kalacak"
                    + (f" ({', '.join(apps_kept)})." if apps_kept else "."))
            if plan.keep:
                notes.append("Yerinde kalacak paketler \"elle kurulmuş\" olarak işaretlenecek.")
        for pkg in flatpaks:
            lines.append(f"{pkg.title:<40} {human(pkg.size):>10}  (Flatpak, {pkg.installation})")
            total += pkg.size

        text = (f"{len(selected)} program kaldırılacak ({len(lines)} paket), "
                f"yaklaşık {human(total)} yer açılacak.\nBu işlem geri alınamaz.")
        if warnings:
            text += "\n\nDikkat:\n" + "\n".join(warnings)
        if notes:
            text += "\n\n" + "\n".join(notes)
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Icon.Warning)
        box.setWindowTitle("Kaldırma onayı")
        box.setText(text)
        box.setInformativeText("Kaldırılacakların tam listesi için \"Ayrıntıları göster\"e bas.")
        box.setDetailedText("\n".join(lines))
        box.setStandardButtons(QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel)
        box.button(QMessageBox.StandardButton.Yes).setText("Kaldır")
        box.setDefaultButton(QMessageBox.StandardButton.Cancel)
        if box.exec() != QMessageBox.StandardButton.Yes:
            return

        steps = []
        if plan and plan.keep:
            # Tek yetki penceresiyle: önce kalacakları "elle kurulmuş" yap, sonra kaldır
            script = ('set -e; n=$1; shift; pacman -D --asexplicit "${@:1:$n}"; '
                      'shift "$n"; exec pacman -Rns --noconfirm "$@"')
            steps.append(["pkexec", "/usr/bin/bash", "-c", script, "kaldir",
                          str(len(plan.keep)), *plan.keep, *plan.targets])
        elif plan:
            steps.append(["pkexec", "pacman", "-Rns", "--noconfirm", *plan.targets])
        for installation in ("system", "user"):
            ids = [p.name for p in flatpaks if p.installation == installation]
            if ids:
                steps.append(["flatpak", "uninstall", "--noninteractive", f"--{installation}", *ids])

        RunDialog(self, steps).start()
        self.load()


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Kaldır")
    app.setDesktopFileName("kaldir-gui")
    ensure_icon_theme()
    window = Window()
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
