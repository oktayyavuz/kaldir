def print_protected():
    installed = set(_output(["pacman", "-Qq"]).split())
    has_flatpak_apps = bool(_output(["flatpak", "list", "--app", "--columns=application"]).strip())
    protected, _ = compute_protection(installed, has_flatpak_apps)
    for name in sorted(protected):
        print(f"{name}\t{protected[name]}")


def print_list(everything: bool):
    packages, _ = load_packages()
    for pkg in packages:
        if pkg.protected or not (everything or pkg.is_app):
            continue
        print(f"{pkg.source}\t{pkg.size}\t{pkg.name}\t{pkg.title}")


def print_plan(names: list[str]) -> int:
    """Satırlar: KALDIR ad bayt | KORU ad neden | DEMET ad | HATA metin"""
    packages, state = load_packages()
    plan = plan_pacman_removal(names, state, {p.name: p.title for p in packages})
    if not plan.ok:
        for reason in plan.reasons or [plan.error]:
            print(f"HATA\t{reason}")
        return 1
    for name in plan.bundles:
        print(f"DEMET\t{name}")
    for name in plan.keep:
        why = state.protected.get(name) or "Demetin içindeki diğer paket; yerinde kalır"
        print(f"KORU\t{name}\t{why}")
    for name, size in plan.remove:
        print(f"KALDIR\t{name}\t{size}")
    return 0


if __name__ == "__main__":
    _args = sys.argv[1:]
    if "--korunanlar" in _args:
        print_protected()
        sys.exit(0)
    if "--liste" in _args:
        print_list("--hepsi" in _args)
        sys.exit(0)
    if "--plan" in _args:
        sys.exit(print_plan([a for a in _args if not a.startswith("--")]))


