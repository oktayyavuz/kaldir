class SizeItem(QTableWidgetItem):
    """Boyut sütununu metne göre değil bayta göre sıralar."""

    def __lt__(self, other):
        return (self.data(Qt.ItemDataRole.UserRole) or 0) < (other.data(Qt.ItemDataRole.UserRole) or 0)


class Loader(QThread):
    loaded = pyqtSignal(object)

    def run(self):
        self.loaded.emit(load_packages())


class RunDialog(QDialog):
    """Komutları sırayla çalıştırıp çıktılarını canlı gösterir."""

    def __init__(self, parent, steps: list[list[str]]):
        super().__init__(parent)
        self.setWindowTitle("Kaldırılıyor")
        self.resize(760, 420)
        self.steps = list(steps)
        self.failed = False

        self.log = QPlainTextEdit(readOnly=True)
        self.log.setFont(QFont("monospace"))
        self.state = QLabel("Çalışıyor… Yetki penceresi açılırsa şifreni gir.")
        self.buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        self.buttons.setEnabled(False)
        self.buttons.rejected.connect(self.accept)

        layout = QVBoxLayout(self)
        layout.addWidget(self.log)
        layout.addWidget(self.state)
        layout.addWidget(self.buttons)

        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self._read)
        self.proc.finished.connect(self._step_finished)
        self.proc.errorOccurred.connect(self._error)

    def start(self):
        self._next()
        return self.exec()

    def _read(self):
        text = bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        self.log.insertPlainText(text)
        self.log.ensureCursorVisible()

    def _next(self):
        if not self.steps:
            self._done()
            return
        cmd = self.steps.pop(0)
        self.log.appendPlainText(f"$ {' '.join(cmd)}\n")
        self.proc.start(cmd[0], cmd[1:])

    def _step_finished(self, code, status):
        if status != QProcess.ExitStatus.NormalExit or code != 0:
            self.failed = True
            reason = ("Yetkilendirme iptal edildi ya da reddedildi." if code in (126, 127)
                      else f"Çıkış kodu {code}.")
            self.log.appendPlainText(f"\n✗ İşlem başarısız. {reason}")
            self._done()
            return
        self.log.appendPlainText("\n✓ Tamamlandı.\n")
        self._next()

    def _error(self, error):
        if error == QProcess.ProcessError.FailedToStart:
            self.failed = True
            self.log.appendPlainText("\n✗ Komut başlatılamadı.")
            self._done()

    def _done(self):
        self.state.setText("Bazı işlemler başarısız oldu, hiçbir şey kaldırılmamış olabilir."
                           if self.failed else "Tüm işlemler tamamlandı.")
        self.buttons.setEnabled(True)

    def reject(self):
        # Çalışırken pencere kapatılmasın
        if self.buttons.isEnabled():
            super().reject()


class Window(QMainWindow):
    COL_NAME, COL_SOURCE, COL_SIZE, COL_DESC = range(4)

    def __init__(self, autoload: bool = True):
        super().__init__()
        self.setWindowTitle("Kaldır")
        self.setWindowIcon(QIcon.fromTheme("edit-delete"))
        self.resize(1000, 660)
        self.packages: list[Package] = []
        self.protected: dict[str, str] = {}
        self.warn: dict[str, str] = {}
        self.loader = None

        self.search = QLineEdit(placeholderText="Ad veya açıklamaya göre ara…")
        self.search.setClearButtonEnabled(True)
        self.source = QComboBox()
        self.source.addItems(["Tümü", "Pacman", "AUR", "Flatpak"])
        self.show_protected = QCheckBox("Korumalı sistem paketlerini göster")
        self.refresh_btn = QPushButton(QIcon.fromTheme("view-refresh"), "Yenile")

        top = QHBoxLayout()
        top.addWidget(self.search, 1)
        top.addWidget(self.source)
        top.addWidget(self.show_protected)
        top.addWidget(self.refresh_btn)

        self.table = QTableWidget(0, 4)
        self.table.setHorizontalHeaderLabels(["Ad", "Kaynak", "Boyut", "Açıklama"])
        self.table.verticalHeader().setVisible(False)
        self.table.setSelectionBehavior(QAbstractItemView.SelectionBehavior.SelectRows)
        self.table.setEditTriggers(QAbstractItemView.EditTrigger.NoEditTriggers)
        self.table.setAlternatingRowColors(True)
        self.table.setWordWrap(False)
        header = self.table.horizontalHeader()
        for col in (self.COL_NAME, self.COL_SOURCE, self.COL_SIZE):
            header.setSectionResizeMode(col, QHeaderView.ResizeMode.ResizeToContents)
        header.setSectionResizeMode(self.COL_DESC, QHeaderView.ResizeMode.Stretch)

        self.legend = QLabel("🔒 korumalı, seçilemez    ⚠ dikkat gerektirir    "
                             "Satıra tıkla ya da Boşluk'a bas: seç")
        self.legend.setEnabled(False)
        self.status = QLabel("Yükleniyor…")
        self.clear_btn = QPushButton("Seçimi temizle")
        self.remove_btn = QPushButton(QIcon.fromTheme("edit-delete"), "Seçilenleri kaldır")
        self.remove_btn.setEnabled(False)

        bottom = QHBoxLayout()
        bottom.addWidget(self.status, 1)
        bottom.addWidget(self.clear_btn)
        bottom.addWidget(self.remove_btn)

        central = QWidget()
        layout = QVBoxLayout(central)
        layout.addLayout(top)
        layout.addWidget(self.table, 1)
        layout.addWidget(self.legend)
        layout.addLayout(bottom)
        self.setCentralWidget(central)

        self.search.textChanged.connect(self.apply_filter)
        self.source.currentIndexChanged.connect(self.apply_filter)
        self.show_protected.toggled.connect(self.apply_filter)
        self.refresh_btn.clicked.connect(self.load)
        self.clear_btn.clicked.connect(self.clear_selection)
        self.remove_btn.clicked.connect(self.remove_selected)
        self.table.itemChanged.connect(self.update_status)
        self.table.cellClicked.connect(self.toggle_row)
        QShortcut(QKeySequence.StandardKey.Find, self, self.search.setFocus)
        QShortcut(QKeySequence(Qt.Key.Key_Space), self.table, self.toggle_current)

        if autoload:
            self.load()

    # --- Yükleme ve listeleme -------------------------------------------

    def load(self):
        self.refresh_btn.setEnabled(False)
        self.remove_btn.setEnabled(False)
        self.status.setText("Paketler okunuyor…")
        self.loader = Loader()
        self.loader.loaded.connect(self.populate)
        self.loader.start()

    def populate(self, result):
        self.packages, self.protected, self.warn = result
        dim = QBrush(self.palette().color(QPalette.ColorGroup.Disabled, QPalette.ColorRole.Text))
        self.table.blockSignals(True)
        self.table.setSortingEnabled(False)
        self.table.clearContents()
        self.table.setRowCount(len(self.packages))
        for row, pkg in enumerate(self.packages):
            name = QTableWidgetItem(pkg.name)
            name.setData(Qt.ItemDataRole.UserRole, row)
            source = QTableWidgetItem(pkg.source)
            size = SizeItem(human(pkg.size))
            size.setData(Qt.ItemDataRole.UserRole, pkg.size)
            size.setTextAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
            desc = QTableWidgetItem(pkg.description)
            items = (name, source, size, desc)

            if pkg.protected:
                name.setFlags(name.flags() & ~Qt.ItemFlag.ItemIsUserCheckable)
                name.setText(f"🔒 {pkg.name}")
                tip = f"Korumalı: {pkg.protected}"
                for item in items:
                    item.setForeground(dim)
                    item.setToolTip(tip)
            else:
                name.setFlags(name.flags() | Qt.ItemFlag.ItemIsUserCheckable)
                name.setCheckState(Qt.CheckState.Unchecked)
                if pkg.warning:
                    name.setText(f"⚠ {pkg.name}")
                    tip = f"Dikkat: {pkg.warning}"
                else:
                    tip = pkg.description
                for item in items:
                    item.setToolTip(tip)

            for col, item in enumerate(items):
                self.table.setItem(row, col, item)
        self.table.setSortingEnabled(True)
        self.table.sortItems(self.COL_SIZE, Qt.SortOrder.DescendingOrder)
        self.table.blockSignals(False)
        self.refresh_btn.setEnabled(True)
        self.apply_filter()
        self.update_status()

    def apply_filter(self):
        text = self.search.text().strip().lower()
        source = self.source.currentText()
        show_protected = self.show_protected.isChecked()
        for row in range(self.table.rowCount()):
            pkg = self.package_at(row)
            visible = ((source == "Tümü" or pkg.source == source)
                       and (show_protected or not pkg.protected)
                       and (not text or text in pkg.name.lower() or text in pkg.description.lower()))
            self.table.setRowHidden(row, not visible)

    def package_at(self, row: int) -> Package:
        return self.packages[self.table.item(row, self.COL_NAME).data(Qt.ItemDataRole.UserRole)]

    # --- Seçim -----------------------------------------------------------

    def checked_packages(self) -> list[Package]:
        result = []
        for row in range(self.table.rowCount()):
            pkg = self.package_at(row)
            if not pkg.protected and self.table.item(row, self.COL_NAME).checkState() == Qt.CheckState.Checked:
                result.append(pkg)
        return result

    def toggle_row(self, row: int, column: int):
        if column == self.COL_NAME or self.package_at(row).protected:
            return
        item = self.table.item(row, self.COL_NAME)
        item.setCheckState(Qt.CheckState.Unchecked if item.checkState() == Qt.CheckState.Checked
                           else Qt.CheckState.Checked)

    def toggle_current(self):
        row = self.table.currentRow()
        if row >= 0:
            self.toggle_row(row, self.COL_SOURCE)

    def clear_selection(self):
        self.table.blockSignals(True)
        for row in range(self.table.rowCount()):
            if not self.package_at(row).protected:
                self.table.item(row, self.COL_NAME).setCheckState(Qt.CheckState.Unchecked)
        self.table.blockSignals(False)
        self.update_status()

    def update_status(self, *_):
        selected = self.checked_packages()
        removable = [p for p in self.packages if not p.protected]
        locked = len(self.packages) - len(removable)
        text = (f"{len(removable)} kaldırılabilir uygulama · {human(sum(p.size for p in removable))}"
                f" · {locked} korumalı")
        if selected:
            text += f"   |   Seçilen: {len(selected)} · {human(sum(p.size for p in selected))}"
        self.status.setText(text)
        self.remove_btn.setEnabled(bool(selected))

    # --- Kaldırma ------------------------------------------------------

    def remove_selected(self):
        selected = self.checked_packages()
        if any(p.protected for p in selected):  # arayüz izin vermez; yine de kontrol
            return
        pacman_names = [p.name for p in selected if p.source in ("Pacman", "AUR")]
        flatpaks = [p for p in selected if p.source == "Flatpak"]

        lines, warnings, total = [], [], 0
        keep_deps: list[str] = []
        if pacman_names:
            ok, items, error = preview_pacman_removal(pacman_names)
            if not ok:
                reasons = explain_dependency_error(error)
                box = QMessageBox(QMessageBox.Icon.Warning, "Kaldırılamaz",
                                  "Seçtiğin paketlerden en az biri başka bir paket tarafından "
                                  "kullanılıyor, bu yüzden hiçbir şey kaldırılmadı.\n\n"
                                  + ("\n".join(reasons) + "\n\n" if reasons else "")
                                  + "Onu kullanan paketi de seçebilir ya da seçimini değiştirebilirsin.",
                                  QMessageBox.StandardButton.Ok, self)
                box.setDetailedText(error)
                box.exec()
                return

            # İkinci kontrol: bağımlılık olarak korumalı bir paket silinecek mi?
            # Öyleyse onu (ve ona gereken bağımlılıkları) yerinde bırak.
            names_in_preview = {n for n, _ in items}
            protected_deps = [n for n in names_in_preview if n in self.protected]
            if protected_deps:
                if any(n in pacman_names for n in protected_deps):  # olmamalı; yine de dur
                    QMessageBox.critical(self, "Korumalı paket", "Korumalı bir paket seçilmiş, durduruldu.")
                    return
                kept = dependency_closure(protected_deps, names_in_preview)
                keep_deps = sorted(protected_deps)
                items = [(n, s) for n, s in items if n not in kept]
                warnings += [f"🔒 {n} korunacak — {self.protected[n]}" for n in keep_deps]

            for name, size in items:
                note = "" if name in pacman_names else "  (artık gereksiz bağımlılık)"
                lines.append(f"{name:<40} {human(size):>10}{note}")
                total += size
                if name in self.warn:
                    warnings.append(f"⚠ {name} — {self.warn[name]}")
        for pkg in flatpaks:
            lines.append(f"{pkg.name:<40} {human(pkg.size):>10}  (Flatpak, {pkg.installation})")
            total += pkg.size

        text = (f"{len(lines)} paket kaldırılacak, yaklaşık {human(total)} yer açılacak.\n"
                "Bu işlem geri alınamaz.")
        if warnings:
            text += "\n\nDikkat:\n" + "\n".join(warnings)
        if keep_deps:
            text += ("\n\n🔒 işaretliler bağımlılık olarak silinecekti; \"elle kurulmuş\" "
                     "olarak işaretlenip yerinde bırakılacak.")
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Icon.Warning)
        box.setWindowTitle("Kaldırma onayı")
        box.setText(text)
        box.setInformativeText("Kaldırılacakların tam listesi için \"Ayrıntıları göster\"e bas.")
        box.setDetailedText("\n".join(lines))
        box.setStandardButtons(QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.Cancel)
        box.button(QMessageBox.StandardButton.Yes).setText("Kaldır")
        box.setDefaultButton(QMessageBox.StandardButton.Cancel)
        if box.exec() != QMessageBox.StandardButton.Yes:
            return

        steps = []
        if pacman_names and keep_deps:
            # Tek yetki penceresiyle: önce korunacakları "elle kurulmuş" yap, sonra kaldır
            script = ('set -e; n=$1; shift; pacman -D --asexplicit "${@:1:$n}"; '
                      'shift "$n"; exec pacman -Rns --noconfirm "$@"')
            steps.append(["pkexec", "/usr/bin/bash", "-c", script, "kaldir",
                          str(len(keep_deps)), *keep_deps, *pacman_names])
        elif pacman_names:
            steps.append(["pkexec", "pacman", "-Rns", "--noconfirm", *pacman_names])
        for installation in ("system", "user"):
            ids = [p.name for p in flatpaks if p.installation == installation]
            if ids:
                steps.append(["flatpak", "uninstall", "--noninteractive", f"--{installation}", *ids])

        RunDialog(self, steps).start()
        self.load()


