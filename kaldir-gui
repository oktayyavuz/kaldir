DESKTOP_DIRS = ["/usr/share/applications", "/usr/local/share/applications"]


def read_desktop_entry(path: str) -> dict | None:
    """Menüde görünen bir uygulama girdisiyse alanlarını, değilse None döndürür."""
    entry, inside = {}, False
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    if inside:
                        break
                    inside = line == "[Desktop Entry]"
                elif inside and "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    entry.setdefault(key.strip(), value.strip())
    except OSError:
        return None
    if entry.get("Type") != "Application":
        return None
    if entry.get("NoDisplay", "").lower() == "true" or entry.get("Hidden", "").lower() == "true":
        return None
    return entry


def desktop_apps() -> dict[str, list[dict]]:
    """Paket -> menüde görünen uygulama girdileri [{name, icon, file}]."""
    entries = {}
    for directory in DESKTOP_DIRS:
        for root, _, files in os.walk(directory):
            for file in files:
                if file.endswith(".desktop"):
                    path = os.path.join(root, file)
                    entry = read_desktop_entry(path)
                    if entry:
                        entries[path] = entry
    apps: dict[str, list[dict]] = {}
    for path, pkg in _owners_of(sorted(entries)).items():
        entry = entries[path]
        stem = os.path.basename(path)[:-len(".desktop")]
        apps.setdefault(pkg, []).append({
            "name": entry.get("Name[tr]") or entry.get("Name") or stem,
            "icon": entry.get("Icon", ""),
            "file": stem,
        })
    return apps


def primary_entry(pkg: str, entries: list[dict]) -> dict:
    """Bir paketin birden çok girdisi varsa (LibreOffice gibi) ana olanı seçer."""
    base = re.sub(r"-(bin|git|fresh|stable|desktop)$", "", pkg.lower())

    def rank(entry):
        stem = entry["file"].lower()
        exact = stem in (pkg.lower(), base) or stem.rsplit(".", 1)[-1] == base
        return (not exact, len(entry["name"]), entry["name"])
    return min(entries, key=rank)


def _dep_name(dep: str) -> str:
    return re.split(r"[<>=]", dep)[0]


@dataclass
class SystemState:
    """Kaldırma kararları için gereken her şey."""
    protected: dict
    warn: dict
    depends: dict      # paket -> doğrudan bağımlılıkları (kurulu paket adlarıyla)
    required_by: dict  # paket -> onu gerektiren paketler
    bundles: set       # demet (meta) paketleri


def resolve_depends(infos: list[dict]) -> dict[str, set[str]]:
    installed = {i["Name"] for i in infos}
    provides = {}
    for info in infos:
        for item in info.get("Provides", "None").split():
            if item != "None":
                provides.setdefault(_dep_name(item), info["Name"])
    depends = {}
    for info in infos:
        result = set()
        for dep in info.get("Depends On", "None").split():
            name = _dep_name(dep)
            if name in installed:
                result.add(name)
            elif name in provides:
                result.add(provides[name])
        depends[info["Name"]] = result
    return depends


def find_bundles(candidates: set[str]) -> set[str]:
    """Kendi içinde program barındırmayan, yalnızca başka paketleri çeken demet paketleri."""
    if not candidates:
        return set()
    files: dict[str, list[str]] = {name: [] for name in candidates}
    for line in _output(["pacman", "-Ql", *sorted(candidates)]).splitlines():
        name, _, path = line.partition(" ")
        if path and not path.endswith("/"):
            files.setdefault(name, []).append(path)
    bundles = set()
    for name, paths in files.items():
        real = [p for p in paths if not p.startswith(("/usr/share/licenses/", "/usr/share/doc/"))]
        if len(real) <= 3 and not any(
                p.startswith(("/usr/bin/", "/opt/")) or ".so" in p or p.endswith(".desktop")
                for p in real):
            bundles.add(name)
    return bundles


def _owners(path: str) -> set[str]:
    if not path or not os.path.exists(path):
        return set()
    return set(_output(["pacman", "-Qqo", path]).split())


def base_dependencies() -> set[str]:
    for info in parse_pacman_info(_output(["pacman", "-Qi", "base"])):
        deps = info.get("Depends On", "")
        return {re.split(r"[<>=]", d)[0] for d in deps.split()} - {"None"}
    return set()


def user_protected() -> dict[str, str]:
    """~/.config/kaldir/korunan.txt: her satırda bir paket, isteğe bağlı '# neden'."""
    result = {}
    try:
        with open(USER_PROTECTED_FILE, encoding="utf-8") as f:
            for line in f:
                name, _, note = line.partition("#")
                name = name.strip()
                if name:
                    result[name] = note.strip() or "Senin koruma listende"
    except OSError:
        pass
    return result


def _owners_of(paths: list[str]) -> dict[str, str]:
    """Dosya -> sahibi paket (tek pacman çağrısıyla)."""
    paths = [p for p in paths if os.path.exists(p)]
    if not paths:
        return {}
    result = {}
    for line in _output(["pacman", "-Qo", *paths]).splitlines():
        m = re.match(r"^(\S+) is owned by (\S+) ", line)
        if m:
            result[m.group(1)] = m.group(2)
    return result


def dynamic_warnings() -> dict[str, str]:
    """Bu makinede gerçekten kullanılanlardan uyarı nedenleri çıkarır: ad -> neden."""
    reasons: dict[str, list[str]] = {}

    def add(pkg, reason):
        reasons.setdefault(pkg, [])
        if reason not in reasons[pkg]:
            reasons[pkg].append(reason)

    # Açılışta çalışan servisler (sistem ve kullanıcı)
    for scope, base in ((["systemctl"], "/usr/lib/systemd/system"),
                        (["systemctl", "--user"], "/usr/lib/systemd/user")):
        units = _output([*scope, "list-unit-files", "--state=enabled", "--no-legend",
                         "--type=service,timer,socket,path"]).split("\n")
        paths = {}
        for line in units:
            unit = line.split()[0] if line.split() else ""
            if not unit:
                continue
            template = re.sub(r"@[^.]+\.", "@.", unit)  # getty@tty1.service -> getty@.service
            paths[os.path.join(base, template)] = unit
        for path, pkg in _owners_of(list(paths)).items():
            add(pkg, f"Açılışta çalışıyor ({paths[path]})")

    # .zshrc / .bashrc içinde ve oturum açılışında otomatik başlayan komutlar
    def commands_in(text):
        return {w for w in re.findall(r"\b[a-zA-Z][\w.+-]*\b", text) if os.path.exists(f"/usr/bin/{w}")}

    sources = [("~/.zshrc", "Her terminal açılışında kullanılıyor (.zshrc)"),
               ("~/.bashrc", "Her terminal açılışında kullanılıyor (.bashrc)")]
    for path, reason in sources:
        try:
            with open(os.path.expanduser(path), encoding="utf-8") as f:
                cmds = commands_in(f.read())
        except OSError:
            continue
        for file, pkg in _owners_of([f"/usr/bin/{c}" for c in cmds]).items():
            if pkg not in ("coreutils", "bash", "zsh", "grep", "sed", "gawk", "findutils"):
                add(pkg, reason)

    autostart = glob.glob(os.path.expanduser("~/.config/autostart/*.desktop"))
    cmds = set()
    for path in autostart:
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    if line.startswith("Exec="):
                        first = line[5:].split()[0] if line[5:].split() else ""
                        name = os.path.basename(first)
                        if os.path.exists(f"/usr/bin/{name}"):
                            cmds.add(name)
        except OSError:
            continue
    for file, pkg in _owners_of([f"/usr/bin/{c}" for c in cmds]).items():
        add(pkg, "Oturum açılışında otomatik başlıyor")

    return {pkg: " · ".join(r) for pkg, r in reasons.items()}


def compute_protection(installed: set[str], has_flatpak_apps: bool) -> tuple[dict, dict]:
    """Kurulu paketler için (korumalı, dikkat) sözlüklerini döndürür: ad -> neden."""
    protected, warn = {}, {}

    def mark(target, name, reason):
        if name in installed and name not in target:
            target[name] = reason

    # Makineye özgü olanlar önce, nedenleri daha açıklayıcı
    running = os.uname().release
    for path in sorted(glob.glob("/usr/lib/modules/*/vmlinuz")):
        version = path.split("/")[4]
        for owner in _owners(path):
            mark(protected, owner, "Şu an çalışan çekirdek" if version == running
                 else "Yedek çekirdek (ana çekirdek açılmazsa gerekir)")
    for owner in _owners(os.path.realpath("/etc/systemd/system/display-manager.service")):
        mark(protected, owner, "Giriş ekranı")
    try:
        shell = os.path.realpath(pwd.getpwuid(os.getuid()).pw_shell)
        for owner in _owners(shell):
            mark(protected, owner, "Varsayılan kabuğun")
    except KeyError:
        pass
    if has_flatpak_apps:
        mark(protected, "flatpak", "Kurulu Flatpak uygulamaların var")

    for name, reason in user_protected().items():
        mark(protected, name, reason)
    for name, reason in PROTECTED.items():
        mark(protected, name, reason)
    for name in base_dependencies():
        mark(protected, name, "Temel sistemin parçası")
    for name in installed:
        for pattern, reason in PROTECTED_PATTERNS:
            if re.match(pattern, name):
                mark(protected, name, reason)

    for name, reason in WARN.items():
        mark(warn, name, reason)
    for name in installed:
        for pattern, reason in WARN_PATTERNS:
            if re.match(pattern, name):
                mark(warn, name, reason)
    for name, reason in dynamic_warnings().items():
        if name in warn:
            warn[name] = f"{warn[name]} · {reason}"
        else:
            mark(warn, name, reason)
    for name in list(warn):
        if name in protected:
            del warn[name]
    return protected, warn


def load_packages() -> tuple[list[Package], SystemState]:
    """Elle kurulmuş paketler, demetle gelmiş uygulamalar ve Flatpak uygulamaları."""
    infos = parse_pacman_info(_output(["pacman", "-Qi"]))
    by_name = {i["Name"]: i for i in infos}
    foreign = set(_output(["pacman", "-Qmq"]).split())
    depends = resolve_depends(infos)
    required_by = {name: set(i.get("Required By", "None").split()) - {"None"}
                   for name, i in by_name.items()}
    apps = desktop_apps()

    # Bağımlılık olarak kurulmuş uygulamalar (örn. Steam) yalnızca bir demet
    # paketinin parçasıysa listelenir; gerçek bir program onları kullanıyorsa değil.
    candidates, stack = set(), [n for n in apps if n in by_name]
    while stack:
        for parent in required_by.get(stack.pop(), ()):
            if parent not in candidates:
                candidates.add(parent)
                stack.append(parent)
    bundles = find_bundles({c for c in candidates if c not in apps})

    flatpaks = flatpak_packages()
    protected, warn = compute_protection(set(by_name), bool(flatpaks))
    state = SystemState(protected, warn, depends, required_by, bundles)

    packages = []
    for name, info in by_name.items():
        explicit = info.get("Install Reason", "").startswith("Explicitly")
        users = required_by.get(name, set())
        bundled_app = name in apps and not explicit and users <= bundles
        if not explicit and not bundled_app:
            continue
        value, unit = (info.get("Installed Size", "0 B").split() + ["B"])[:2]
        pkg = Package(name, "AUR" if name in foreign else "Pacman", to_bytes(value, unit),
                      info.get("Description", ""),
                      protected=protected.get(name, ""), warning=warn.get(name, ""))
        if name in apps:
            entry = primary_entry(name, apps[name])
            pkg.app_name, pkg.icon = entry["name"], entry["icon"]
            pkg.search_text = " ".join(e["name"] for e in apps[name])
        if bundled_app and users:
            pkg.bundle = ", ".join(sorted(users))
        packages.append(pkg)
    packages += flatpaks
    packages.sort(key=lambda p: p.size, reverse=True)
    return packages, state


def preview_pacman_removal(names: list[str]) -> tuple[bool, list[tuple[str, int]], str]:
    """`pacman -Rns` ile birlikte silinecek paketleri döndürür (hiçbir şey silmez).

    Dönüş: (başarılı mı, [(paket, bayt)], hata metni)
    """
    result = subprocess.run(
        ["pacman", "-Rs", "--print", "--print-format", "%n %s", *names],
        capture_output=True, text=True, env=C_ENV)
    if result.returncode != 0:
        # pacman ":: removing X breaks dependency ..." satırlarını stdout'a yazar
        return False, [], f"{result.stderr}\n{result.stdout}".strip()
    items = []
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1].isdigit():
            items.append((parts[0], int(parts[1])))
    return True, items, ""


def dependency_closure(roots: set[str], candidates: set[str], depends: dict) -> set[str]:
    """`roots` ve onların `candidates` içindeki (özyinelemeli) bağımlılıkları."""
    keep, stack = set(), list(roots)
    while stack:
        name = stack.pop()
        if name in keep:
            continue
        keep.add(name)
        stack += [d for d in depends.get(name, ()) if d in candidates and d not in keep]
    return keep


def explain_dependency_error(error: str, titles: dict | None = None) -> list[str]:
    """pacman'in 'breaks dependency' hatalarını okunur satırlara çevirir."""
    titles = titles or {}
    pairs = re.findall(r"removing (\S+) breaks dependency '([^']+)' required by (\S+)", error)
    lines = []
    for removed, _, user in pairs:
        name = titles.get(user, user)
        lines.append(f"• {name} ({user}) bunu kullanıyor: {removed}" if name != user
                     else f"• {user} bunu kullanıyor: {removed}")
    return list(dict.fromkeys(lines))


@dataclass
class RemovalPlan:
    ok: bool
    targets: list[str]                 # pacman -Rns'e verilecek paketler (seçilenler + demetler)
    remove: list[tuple[str, int]]      # gerçekten silinecekler (paket, bayt)
    keep: list[str]                    # önce "elle kurulmuş" yapılıp yerinde bırakılacaklar
    bundles: list[str]                 # seçilen uygulama yüzünden kaldırılacak demet paketleri
    reasons: list[str]                 # başarısızsa okunur nedenler
    error: str = ""


def plan_pacman_removal(names: list[str], state: SystemState,
                        titles: dict | None = None) -> RemovalPlan:
    """Kaldırma planı çıkarır, hiçbir şey silmez.

    * Seçilen bir uygulamayı yalnızca demet paketleri kullanıyorsa demet de
      kaldırılır, ama demetin içindeki diğer paketler yerinde bırakılır.
    * Başka bir gerçek paket kullanıyorsa plan başarısız olur.
    * Bağımlılık olarak silinecek korumalı paketler yerinde bırakılır.
    """
    if any(n in state.protected for n in names):
        bad = [n for n in names if n in state.protected]
        return RemovalPlan(False, list(names), [], [], [],
                           [f"• {n} korumalı — {state.protected[n]}" for n in bad])
    targets, bundles = list(names), []
    for _ in range(8):
        ok, items, error = preview_pacman_removal(targets)
        if ok:
            break
        users = set(re.findall(r"breaks dependency '[^']+' required by (\S+)", error)) - set(targets)
        if users and all(u in state.bundles and u not in state.protected for u in users):
            bundles += sorted(users)
            targets += sorted(users)
            continue
        return RemovalPlan(False, targets, [], [], bundles,
                           explain_dependency_error(error, titles), error)
    else:
        return RemovalPlan(False, targets, [], [], bundles, ["• Bağımlılık zinciri çözülemedi"], error)

    in_preview = {n for n, _ in items}
    roots = {n for n in in_preview if n in state.protected}
    for bundle in bundles:
        roots |= {d for d in state.depends.get(bundle, ()) if d in in_preview}
    roots -= set(targets)
    kept = dependency_closure(roots, in_preview - set(targets), state.depends)
    remove = [(n, s) for n, s in items if n not in kept]
    return RemovalPlan(True, targets, remove, sorted(roots), bundles, [])


