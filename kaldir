#!/usr/bin/env bash
# kaldir: Kurulu programları boyutlarına göre sıralayıp topluca kaldırır.
#
# Kullanım:
#   kaldir                   fzf ile program seç, seçilenleri kaldır
#   kaldir --hepsi           kütüphaneler ve araçlar dahil tüm paketlerden seç
#   kaldir --liste [--hepsi] yalnızca boyuta göre sıralı listeyi yazdır (hiçbir şey silmez)
#
# Varsayılan olarak yalnızca gerçek programlar listelenir: uygulama menüsünde
# görünenler ve Flatpak uygulamaları. Korumalı sistem paketleri hiç gösterilmez.
# Liste ve kaldırma planı `kaldir-gui` ile aynı kurallardan gelir; kendi
# korumalarını ~/.config/kaldir/korunan.txt dosyasına ekleyebilirsin.

set -uo pipefail

for arac in pacman fzf; do
    command -v "$arac" >/dev/null || { echo "kaldir: '$arac' bulunamadı" >&2; exit 1; }
done

# kaldir-gui: önce bu betiğin yanında, sonra PATH'te ara
gui="$(dirname "$(readlink -f "$0")")/kaldir-gui"
[[ -x $gui ]] || gui=$(command -v kaldir-gui) || {
    echo "kaldir: kaldir-gui bulunamadı, güvenlik için durduruldu." >&2
    exit 1
}

hepsi=() liste=0
for arg in "$@"; do
    case $arg in
        --hepsi) hepsi=(--hepsi) ;;
        --liste) liste=1 ;;
        -h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "kaldir: bilinmeyen seçenek: $arg" >&2; exit 1 ;;
    esac
done

# kaldir-gui --liste: KAYNAK<TAB>BAYT<TAB>PAKET<TAB>UYGULAMA ADI (korumalılar hariç)
if ! ham=$("$gui" --liste "${hepsi[@]}" 2>/dev/null) || [[ -z $ham ]]; then
    echo "kaldir: uygulama listesi alınamadı, güvenlik için durduruldu." >&2
    exit 1
fi

# Satır biçimi: [KAYNAK]  BOYUT  Uygulama adı  ·  paket   (paket her zaman son sütun)
sirali_liste() {
    awk -F'\t' '{
        b = $2; u = "B"
        if (b >= 1073741824) { b /= 1073741824; u = "GiB" }
        else if (b >= 1048576) { b /= 1048576; u = "MiB" }
        else if (b >= 1024) { b /= 1024; u = "KiB" }
        printf "%-10s %9.1f %-3s   %-30s · %s\n", "[" toupper($1) "]", b, u, $4, $3
    }' <<< "$ham"
}

if (( liste )); then
    sirali_liste
    exit 0
fi

mapfile -t secimler < <(sirali_liste | fzf --multi \
    --prompt="Kaldırılacak programı ara > " \
    --header="[Tab]: Çoklu seç | [Enter]: Kaldır | [Esc]: Vazgeç" \
    --marker="✓ ")

# Hiçbir şey seçilmediyse çık
(( ${#secimler[@]} )) || exit 0

pacman_list=()
flatpak_list=()
for satir in "${secimler[@]}"; do
    pkg=${satir##* }
    case $satir in
        '[PACMAN]'* | '[AUR]'*) pacman_list+=("$pkg") ;;
        '[FLATPAK]'*) flatpak_list+=("$pkg") ;;
    esac
done

if (( ${#pacman_list[@]} )); then
    # Kaldırma planı (hiçbir şey silmez): başka bir program kullanıyorsa reddeder,
    # demetle gelen programlarda demeti kaldırıp içindekileri yerinde bırakır,
    # bağımlılık olarak silinecek korumalı paketleri yerinde bırakır.
    plan=$("$gui" --plan "${pacman_list[@]}" 2>&1)
    plan_kodu=$?
    if (( plan_kodu != 0 )); then
        printf '\n\033[1;31m==>\033[0m Kaldırılamaz, hiçbir şey silinmedi:\n' >&2
        awk -F'\t' '$1 == "HATA" { print "    " $2; next } { print "    " $0 }' <<< "$plan" >&2
        exit 1
    fi
    mapfile -t demetler < <(awk -F'\t' '$1 == "DEMET" { print $2 }' <<< "$plan")
    mapfile -t korunacak < <(awk -F'\t' '$1 == "KORU" { print $2 }' <<< "$plan")

    if (( ${#demetler[@]} )); then
        printf '\n\033[1;34m==>\033[0m Seçtiğin program şu demetle kurulmuş: %s\n' "${demetler[*]}"
        printf '    Demet paketi de kaldırılacak; içindeki diğer paketler yerinde kalacak.\n'
    fi
    if (( ${#korunacak[@]} )); then
        printf '\n\033[1;34m==>\033[0m Bunlar "elle kurulmuş" olarak işaretlenip yerinde bırakılacak:\n'
        awk -F'\t' '$1 == "KORU" { printf "    %-28s %s\n", $2, $3 }' <<< "$plan"
        sudo pacman -D --asexplicit "${korunacak[@]}" || exit 1
    fi
    printf '\n\033[1;33m==>\033[0m Kaldırılıyor: %s\n' "${pacman_list[*]} ${demetler[*]}"
    sudo pacman -Rns "${pacman_list[@]}" "${demetler[@]}"
fi

# Flatpak uygulamalarını topluca kaldır
if (( ${#flatpak_list[@]} )); then
    printf '\n\033[1;34m==>\033[0m Flatpak uygulamaları kaldırılıyor: %s\n' "${flatpak_list[*]}"
    flatpak uninstall "${flatpak_list[@]}"
fi
